# ============================================================
# Barakah Foundation - Environment Configuration Template
# Location: .env (copy from this template)
# IMPORTANT: Never commit .env file to version control!
# ============================================================

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# Format: mysql://username:password@host/database
# - username: MySQL user (e.g., barakah_user)
# - password: MySQL password
# - host: MySQL server (usually localhost)
# - database: Database name (e.g., barakah_foundation)

DATABASE_URL=mysql://barakah_user:strong_password_here@localhost/barakah_foundation

# ============================================================
# SERVER CONFIGURATION
# ============================================================
# HOST: Bind address (127.0.0.1 = local only, use with proxy)
# PORT: Backend server port (nginx/Apache proxies requests)
# IMPORTANT: For cPanel, use 127.0.0.1:8080 (not exposed publicly)

HOST=127.0.0.1
PORT=8080

# ============================================================
# JWT AUTHENTICATION
# ============================================================
# JWT_SECRET: Secret key for signing JWT tokens
# SECURITY: Use a strong, random 32+ character string
# Generate: openssl rand -base64 32
# Example: kG7mN2xQ9pL5vR8yW1jH4bF6tD3sE0uC8aZ9xK2pM4

JWT_SECRET=your_secret_key_minimum_32_characters_change_this_to_random_value

# ============================================================
# LOGGING
# ============================================================
# LOG_LEVEL: trace, debug, info, warn, error
# RECOMMENDED: info (production), debug (development)

LOG_LEVEL=info

# ============================================================
# CORS CONFIGURATION (if needed)
# ============================================================
# ALLOWED_ORIGINS: Comma-separated list of allowed domains
# Example: https://yourdomain.com,https://www.yourdomain.com

# ALLOWED_ORIGINS=https://yourdomain.com

# ============================================================
# OPTIONAL: FILE UPLOAD CONFIGURATION
# ============================================================
# MAX_UPLOAD_SIZE: Maximum file size in bytes (default: 10MB)
# MAX_UPLOAD_SIZE=10485760

# UPLOAD_PATH: Directory for file uploads (relative to app root)
# UPLOAD_PATH=uploads

# ============================================================
# OPTIONAL: PAGINATION
# ============================================================
# DEFAULT_PAGE_SIZE: Items per page (default: 20)
# DEFAULT_PAGE_SIZE=20

# ============================================================
# OPTIONAL: SESSION CONFIGURATION
# ============================================================
# SESSION_TIMEOUT: Session timeout in minutes (default: 1440 = 24 hours)
# SESSION_TIMEOUT=1440

# ============================================================
# SETUP INSTRUCTIONS FOR cPANEL
# ============================================================
# 1. SSH into your cPanel server
# 2. Copy this file: cp deploy/.env.template backend/.env
# 3. Edit with your credentials: nano backend/.env
# 4. Update the following:
#    - DATABASE_URL: Your MySQL credentials
#    - JWT_SECRET: Generate random string (openssl rand -base64 32)
# 5. Set permissions: chmod 600 backend/.env (read-only by owner)
# 6. Verify: cat backend/.env (should not be world-readable)
#
# ============================================================
# SECURITY CHECKLIST
# ============================================================
# ✓ Use strong, unique password for MySQL
# ✓ Use random 32+ character JWT_SECRET
# ✓ Never share or commit .env file
# ✓ Set file permissions to 600 (owner read-only)
# ✓ Use HTTPS for all connections
# ✓ Enable firewall and restrict SSH access
# ✓ Regular backups of database
# ✓ Monitor error logs for suspicious activity
