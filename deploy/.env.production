# ============================================================
# Barakah Foundation — Production Environment
# ============================================================
# Copy this file to ~/app/.env on the server and fill in
# your actual cPanel database credentials.
#
# In cPanel: MySQL Databases → create database + user → assign
# ============================================================

# MySQL connection (use cPanel database credentials)
# Format: mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME
DATABASE_URL=mysql://cpanel_dbuser:StrongPassword123@localhost:3306/cpanel_dbname

# Server binding — keep 127.0.0.1 for shared hosting
HOST=127.0.0.1
PORT=8080

# JWT — generate a strong random secret (min 32 chars)
# Generate one: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_STRING_MIN_32_CHARS

# Token expiry in hours (default 24)
JWT_EXPIRES_HOURS=24

# Logging level: error | warn | info | debug
RUST_LOG=info
