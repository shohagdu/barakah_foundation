# ============================================================
# Barakah Foundation — Apache .htaccess
# Location: public_html/barakah_foundation/.htaccess
# ============================================================

RewriteEngine On
RewriteBase /barakah_foundation/

# ── Force HTTPS ──────────────────────────────────────────────
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://shohozit.com/%{REQUEST_URI} [L,R=301]

# ── Proxy /barakah_foundation/api/* → Rust backend port 8080 ─
# Strips /barakah_foundation prefix, forwards /api/* to backend
RewriteCond %{REQUEST_URI} ^/barakah_foundation/api [NC]
RewriteRule ^api/(.*)$ http://127.0.0.1:8080/api/$1 [P,L]

# ── React SPA fallback ───────────────────────────────────────
# All non-file, non-directory routes → index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /barakah_foundation/index.html [L]

# ── Security headers ─────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Cache static assets ──────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css               "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png              "access plus 1 year"
    ExpiresByType image/jpeg             "access plus 1 year"
    ExpiresByType image/svg+xml          "access plus 1 year"
    ExpiresByType image/x-icon           "access plus 1 year"
    ExpiresByType font/woff2             "access plus 1 year"
    ExpiresByType text/html              "access plus 0 seconds"
</IfModule>

# ── Block access to sensitive files ──────────────────────────
<FilesMatch "\.(env|sh|sql|log|pid|toml|lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>
